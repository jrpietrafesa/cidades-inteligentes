      "type": "integer",
      "minimum": 1
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "cidade": {
      "type": "string",
      "minLength": 1
    },
    "tipo": {
      "type": "string",
      "minLength": 1
    },
    "limiteDiarioKwh": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "id",
    "nome",
    "cidade",
    "tipo",
    "limiteDiarioKwh"
  ],
  "additionalProperties": false
